// Task 1,2,3
import React, { Component } from 'react';
import './App.css';

class App extends Component {
  constructor(props) {
    super(props);
    this.state = {
      counter: 0,
      message: ''
    };

    // Bind 'this' so it refers to the component inside event handlers
    this.increment = this.increment.bind(this);
    this.decrement = this.decrement.bind(this);
    this.sayHello = this.sayHello.bind(this);
    this.sayWelcome = this.sayWelcome.bind(this);
    this.handlePress = this.handlePress.bind(this);
  }

  // Task 1a: Increment counter
  increment() {
    this.setState({ counter: this.state.counter + 1 });
  }

  // Task 1b: Say Hello + static message
  sayHello() {
    console.log('Hello! Counter incremented.');
  }

  // Decrement counter
  decrement() {
    this.setState({ counter: this.state.counter - 1 });
  }

  // Increase button invokes BOTH increment() and sayHello()
  handleIncreaseClick() {
    this.increment();
    this.sayHello();
  }

  // Task 2: Say Welcome button - invokes function with "welcome" argument
  sayWelcome(msg) {
    this.setState({ message: msg + ' - Welcome!' });
  }

  // Task 3: Synthetic event "onPress" (mapped to onClick in React)
  handlePress(event) {
    // 'event' here is React's SyntheticEvent, not the native browser event
    console.log('Synthetic Event Type:', event.type);
    this.setState({ message: 'I was clicked' });
  }

  render() {
    return (
      <div className="App">
        <h2>Event Handling Examples</h2>

        <div>
          <h3>Counter: {this.state.counter}</h3>
          <button onClick={() => this.handleIncreaseClick()}>Increment</button>
          <button onClick={this.decrement}>Decrement</button>
        </div>

        <div>
          <button onClick={() => this.sayWelcome('welcome')}>Say Welcome</button>
        </div>

        <div>
          <button onClick={this.handlePress}>OnPress</button>
        </div>

        {this.state.message && <p>{this.state.message}</p>}
      </div>
    );
  }
}

export default App;

// 3.task
import React, { Component } from 'react';

class CurrencyConvertor extends Component {
  constructor(props) {
    super(props);
    this.state = {
      rupees: '',
      euro: ''
    };

    this.handleChange = this.handleChange.bind(this);
    this.handleSubmit = this.handleSubmit.bind(this);
  }

  handleChange(event) {
    this.setState({ rupees: event.target.value });
  }

  // Conversion rate: 1 EUR = ~90 INR (approx, adjust as needed)
  handleSubmit(event) {
    event.preventDefault(); // synthetic event method - stops form/page reload
    const rupeeValue = parseFloat(this.state.rupees) || 0;
    const euroValue = (rupeeValue / 90).toFixed(2);
    this.setState({ euro: euroValue });
  }

  render() {
    return (
      <div>
        <h2>Currency Convertor</h2>
        <label>
          Indian Rupees:
          <input
            type="number"
            value={this.state.rupees}
            onChange={this.handleChange}
          />
        </label>
        <button onClick={this.handleSubmit}>Convert</button>
        {this.state.euro && (
          <p>Euro: {this.state.euro}</p>
        )}
      </div>
    );
  }
}

export default CurrencyConvertor;
