# 1. Verify Git installation
git --version

# 2. Set username and email (global, user-level config)
git config --global user.name "Your Name"
git config --global user.email "your.email@example.com"

# 3. Verify configuration
git config --global --list

# 2. Restart Git bash, then test again
notepad++

# 3. Create alias for notepad++
echo "alias notepad++='winpty \"C:\Program Files\Notepad++\notepad++.exe\" -multiInst -notabbar -nosession -noPlugin'" >> ~/.bashrc
notepad++ ~/.bashrc

# 4. Configure notepad++ as Git's default editor
git config --global core.editor "notepad++ -multiInst -notabbar -nosession -noPlugin"

# 5. Verify default editor
git config --global -e

# 1. Create and initialize new project "GitDemo"
mkdir GitDemo
cd GitDemo
git init

# 2. Verify — shows hidden .git folder (working directory metadata)
ls -la

# 3. Create welcome.txt with content
echo "Welcome to Git" > welcome.txt

# 4. Verify file created
ls -la

# 5. Verify content
cat welcome.txt

# 6. Check status — shows welcome.txt as "Untracked"
git status

# 7. Stage the file to be tracked
git add welcome.txt

# 8. Commit with multi-line message (opens notepad++ since no -m flag)
git commit


# 10. Create "GitDemo" project on GitLab (via web UI — don't use Cognizant credentials)

# Link local repo to remote
git remote add origin <your-gitlab-repo-url>

# 11. Pull from remote (sync any existing remote content)
git pull origin master

# 12. Push local commits to remote
git push origin master
